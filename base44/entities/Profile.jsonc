{
  "name": "Profile",
  "type": "object",
  "properties": {
    "companion": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "gold": {
      "type": "number",
      "default": 0
    },
    "streak": {
      "type": "number",
      "default": 0
    },
    "longest_streak": {
      "type": "number",
      "default": 0
    },
    "last_active_date": {
      "type": "string"
    },
    "total_quests": {
      "type": "number",
      "default": 0
    },
    "total_main": {
      "type": "number",
      "default": 0
    },
    "total_side": {
      "type": "number",
      "default": 0
    },
    "timed_quests": {
      "type": "number",
      "default": 0
    },
    "daily_reminder_time": {
      "type": "string"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "carry_over_quests": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "companion",
    "display_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}